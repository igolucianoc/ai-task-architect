# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Banco de dados ────────────────────────────────────────────────────────────
# Em desenvolvimento local (sem Docker): ajuste host/porta conforme necessário
# Em Docker Compose: sobrescrito automaticamente pelo docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_task_architect

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres-aqui
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Token em: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_SEU_TOKEN_AQUI
HUGGINGFACE_MODEL_GENERATION=HuggingFaceH4/zephyr-7b-beta
HUGGINGFACE_MODEL_EVALUATION=HuggingFaceH4/zephyr-7b-beta
