# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Banco de dados ────────────────────────────────────────────────────────────
# Em desenvolvimento local (sem Docker): ajuste host/porta conforme necessário
# Em Docker Compose: sobrescrito automaticamente pelo docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_task_architect

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres-aqui
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Provider exclusivo de LLM. Obtenha seu token em:
#   https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# Modelo usado para inferência (geração). Exemplos:
#   HuggingFaceH4/zephyr-7b-beta
#   mistralai/Mistral-7B-Instruct-v0.2
#   meta-llama/Llama-2-7b-chat-hf (requires access request)
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# Opcional: modelo dedicado à avaliação (LLM Judge, Etapa 07).
# Se ausente, o mesmo HF_MODEL é usado.
# HF_MODEL_EVALUATION=HuggingFaceH4/zephyr-7b-beta
