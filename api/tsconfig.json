{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // `incremental` foi desativado: combinado com o `deleteOutDir` do nest build,
    // o arquivo .tsbuildinfo sobrevivia ao dist apagado e o tsc pulava a emissão,
    // gerando builds "vazios" (dist sem main.js). Sem incremental, cada build
    // sempre emite. O build de um projeto deste tamanho é rápido o suficiente.
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
