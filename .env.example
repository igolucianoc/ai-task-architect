# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_task_architect
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Portas dos serviços ───────────────────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173

# ── Inicialização automática do banco (API) ───────────────────────────────────
# No boot, a API aplica migrations e roda o seed de demonstração (idempotente).
# Defina como "false" para pular qualquer um deles.
RUN_MIGRATIONS=true
RUN_DB_SEED=true
